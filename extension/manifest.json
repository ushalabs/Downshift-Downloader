{
  "manifest_version": 3,
  "name": "Downshift",
  "version": "1.0.0",
  "minimum_chrome_version": "123",
  "description": "Download files and videos with Downshift.",
  "icons": {"16":"icons/downshift-16.png","32":"icons/downshift-32.png","48":"icons/downshift-48.png","128":"icons/downshift-128.png"},
  "key": "",
  "permissions": ["downloads", "downloads.ui", "nativeMessaging", "storage", "alarms", "webRequest", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {"matches": ["https://*.youtube.com/*", "https://youtube.com/*"], "js": ["youtube-player.js"], "all_frames": false, "world": "MAIN", "run_at": "document_start"},
    {"matches": ["http://*/*", "https://*/*"], "js": ["media-probe.js"], "all_frames": true, "match_origin_as_fallback": true, "world": "MAIN", "run_at": "document_start"},
    {"matches": ["http://*/*", "https://*/*"], "js": ["magnet-links.js"], "all_frames": true, "run_at": "document_start"},
    {"matches": ["http://*/*", "https://*/*"], "js": ["file-links.js"], "all_frames": true, "run_at": "document_start"},
    {"matches": ["http://*/*", "https://*/*"], "js": ["video-button.js"], "all_frames": true, "match_origin_as_fallback": true, "run_at": "document_idle"}
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Downshift", "default_popup": "popup.html", "default_icon": {"16":"icons/downshift-16.png","32":"icons/downshift-32.png","48":"icons/downshift-48.png","128":"icons/downshift-128.png"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
