if(NOT DEFINED ROOT OR NOT DEFINED OUTPUT OR NOT DEFINED CONFIGURATION)
    message(FATAL_ERROR "Build fingerprint requires ROOT, OUTPUT and CONFIGURATION")
endif()
file(GLOB_RECURSE inputs LIST_DIRECTORIES false "${ROOT}/src/*" "${ROOT}/assets/*")
list(APPEND inputs "${ROOT}/CMakeLists.txt" "${ROOT}/vcpkg.json" "${ROOT}/packaging/Downshift.rc.in")
list(SORT inputs)
set(result "{\"version\":1,\"configuration\":\"${CONFIGURATION}\",\"files\":{")
set(separator "")
foreach(input IN LISTS inputs)
    file(RELATIVE_PATH relative "${ROOT}" "${input}")
    file(SHA256 "${input}" hash)
    string(APPEND result "${separator}\"${relative}\":\"${hash}\"")
    set(separator ",")
endforeach()
string(APPEND result "}}\n")
file(WRITE "${OUTPUT}" "${result}")
